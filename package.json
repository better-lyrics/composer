{
  "name": "composer",
  "private": true,
  "version": "1.40.2",
  "type": "module",
  "scripts": {
    "dev": "vite-react-ssg dev",
    "build": "tsc -b && vite-react-ssg build",
    "preview": "vite preview",
    "test": "pnpm test:unit && pnpm test:component",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project browser",
    "test:component:watch": "vitest --project browser",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "biome lint --write . && biome format --write .",
    "typecheck": "tsc -b",
    "knip": "knip",
    "knip:production": "knip --production",
    "jscpd": "jscpd",
    "doctor": "npx --yes react-doctor@latest ."
  },
  "dependencies": {
    "@braccato/core": "^1.3.0",
    "@braccato/parsers": "^0.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@lit/react": "^1.0.8",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.101.4",
    "@uimaxbai/am-lyrics": "^1.5.6",
    "@wavesurfer/react": "^1.0.12",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "driver.js": "^1.8.0",
    "lit": "^3.3.3",
    "motion": "^13.1.1",
    "music-metadata": "^11.15.0",
    "nanoid": "^6.0.1",
    "node-diff3": "^3.2.1",
    "obscenity": "^0.4.6",
    "onnxruntime-web": "^1.27.0",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-virtuoso": "^4.18.12",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "wavesurfer.js": "^7.12.11",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/og": "^0.11.1",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "jscpd": "^5.0.16",
    "jsdom": "^29.0.1",
    "knip": "^6.32.2",
    "playwright": "^1.62.1",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.0",
    "vite": "^6.4.3",
    "vite-react-ssg": "0.9.2",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.2.0"
  }
}
