{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": false,
  "workspaces": {
    ".": {
      "entry": ["src/router.tsx", "src/App.tsx", "scripts/build-seo-assets.ts"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
      "ignoreDependencies": ["@vercel/og", "@dnd-kit/sortable", "@dnd-kit/utilities", "lit", "tailwindcss"]
    },
    "packages/insync": {
      "project": ["src/**/*.ts"]
    }
  }
}
