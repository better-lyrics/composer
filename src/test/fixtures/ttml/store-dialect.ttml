    <div begin="11.000" end="20.000" itunes:songPart="Chorus">
      <p begin="11.000" end="15.000" itunes:key="L3" ttm:agent="v1"><span begin="11.000" end="12.000">Hold </span><span begin="12.000" end="13.000">the </span><span begin="13.000" end="15.000">light</span></p>
