  <body dur="0:24.000">
    <div begin="1.000" end="10.400" itunes:songPart="Verse">
      <p begin="1.000" end="5.000" itunes:key="L1" ttm:agent="v1"><span begin="1.200" end="1.800">Lan</span><span begin="1.800" end="2.300">terns </span><span begin="2.300" end="3.100">drift </span><span begin="3.100" end="4.800">north</span></p>
      <p begin="5.400" end="10.400" itunes:key="L2" ttm:agent="v2"><span begin="5.400" end="6.000">Over </span><span begin="6.000" end="6.700">the </span><span begin="6.700" end="8.000">water</span><span begin="8.200" end="10.400" ttm:role="x-bg"><span begin="8.200" end="9.000">(still </span><span begin="9.000" end="10.400">water)</span></span></p>
